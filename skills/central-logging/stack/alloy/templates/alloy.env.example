# /etc/default/alloy (read by the alloy systemd unit). Replace the package's file with this.
CONFIG_FILE="/etc/alloy/conf.d"
CUSTOM_ARGS="--server.http.listen-addr=127.0.0.1:12345 --disable-reporting"
RESTART_ON_UPGRADE=true

# Central Loki (push endpoint behind TLS) and this server's credential login.
LOKI_URL="https://logs-ingest.example.com/loki/api/v1/push"
LOKI_USER="<project>--<server>"

# Labels: lowercase, stable, low cardinality.
PROJECT="foycom"
ENVIRONMENT="production"        # development | staging | production
APPLICATION="foycom-erp"
SERVER="<server>"

# Per-source settings (only for the templates copied into conf.d)
ODOO_LOG="/var/log/odoo/odoo-server.log"
ODOO_SERVICE="odoo-server"
