# Copy to .env (chmod 600). Never commit .env.
# Two access modes (see README "Access modes"):
#   HTTPS  - normal: a TLS front proxy serves GRAFANA_HOST and INGEST_HOST from public DNS.
#   LAN    - no DNS yet: app servers push straight to BIND_ADDR:BIND_PORT over the private LAN,
#            people open Grafana through an SSH tunnel. Settings marked [LAN] below.

# Pinned images (checked 2026-11-26). Upgrade = change here, see README "Upgrade".
LOKI_TAG=3.7.10
GRAFANA_TAG=13.3.1
NGINX_TAG=1.30.8-alpine

# Names the gateway answers to (no port). Several names: separate with a space.
# [LAN] add the logging host's LAN IP to INGEST_HOST:  INGEST_HOST=logs-ingest.example.com 192.0.2.10
GRAFANA_HOST=logs.example.com
INGEST_HOST=logs-ingest.example.com

# The URL people use for Grafana (links, redirects) and whether cookies need HTTPS.
# [LAN] GRAFANA_URL=http://localhost:3000/  and  GF_COOKIE_SECURE=false  (SSH tunnel)
GRAFANA_URL=https://logs.example.com/
GF_COOKIE_SECURE=true
# Push URL used by "logctl.py test-isolation". [LAN] INGEST_URL=http://192.0.2.10:8300
# INGEST_URL=https://logs-ingest.example.com

# Grafana server admin (platform administrators only).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-long-random

# Where the gateway listens (LAN address the front proxy reaches) and who may connect
# besides 127.0.0.1 and BIND_ADDR itself.
# HTTPS: ALLOW_FROM = the front proxy's LAN IP.  [LAN]: the app servers' LAN IPs.
# More than one address: ALLOW_FROM=192.0.2.21; allow 192.0.2.22; allow 192.0.2.0/28
BIND_ADDR=192.0.2.10
BIND_PORT=8300
ALLOW_FROM=192.0.2.1
GRAFANA_LOCAL_PORT=3000

# Container memory caps. Defaults (Loki 1g, Grafana 768m) fit a 4 GB+ host. On a 2 GB host use
#   Loki 768m and Grafana 640m (Grafana 13 idles at ~300-500 MB; below ~600m it gets OOM-killed).
# LOKI_MEM=1g
# GRAFANA_MEM=768m

# Healthcheck: soft disk budget. Small disk (10 GB): LOKI_BUDGET_GB=3, VALVE_MIN_FREE_GB=1.5.
LOKI_BUDGET_GB=5
VALVE_MIN_FREE_GB=3
