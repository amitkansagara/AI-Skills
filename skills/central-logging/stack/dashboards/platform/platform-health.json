{
  "uid": "platform-health",
  "title": "Platform health",
  "tags": [
    "platform"
  ],
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "alertlist",
      "title": "Alerts",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "viewMode": "list",
        "showInstances": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "error": true,
          "noData": true,
          "normal": true
        },
        "maxItems": 20
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Healthcheck reports (silent forwarders, valve actions)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"healthcheck\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Root disk used",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{server}}",
          "expr": "max by (server) (max_over_time({service=\"healthcheck\"} | json v=\"disk_used_pct\" | unwrap v [$__auto]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Loki data size",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{server}}",
          "expr": "max by (server) (max_over_time({service=\"healthcheck\"} | json v=\"loki_bytes\" | unwrap v [$__auto]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Silent forwarders",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{server}}",
          "expr": "max by (server) (max_over_time({service=\"healthcheck\"} | json v=\"silent_servers\" | unwrap v [$__auto]))"
        }
      ]
    }
  ]
}